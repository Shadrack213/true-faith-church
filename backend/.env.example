# =====================================================================
# True Faith Church International: Django backend settings
# Copy this file to backend/.env (git ignores it) and fill in the values.
# On the hosting provider, enter the same names in its "Environment" settings.
# NEVER commit backend/.env, and never put any of these in assets/js/.
# =====================================================================

# --- Django -----------------------------------------------------------
# true only on your own computer. Production: false (or leave out).
DJANGO_DEBUG=true
# Long random value. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# Comma-separated hostnames this API answers to (production: your API's domain)
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Django Admin at /admin/ (later phase). Keep false until you are ready.
DJANGO_ADMIN_ENABLED=false

# --- Database: your Supabase project's PostgreSQL -----------------------
# Supabase dashboard > Connect (top bar) > Session pooler. Use the django_app
# role created by backend/sql/supabase_django_setup.sql, NOT the postgres user:
#   postgresql://django_app.<project-ref>:<django_app password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=
# Only if you use the transaction pooler (port 6543) instead:
# DATABASE_TRANSACTION_POOLER=true

# --- Flyer storage: Supabase Storage (S3-compatible) ---------------------
# Supabase dashboard > Storage > S3 Configuration > "New access key".
# Leave empty on your computer to store uploads in backend/media/ instead.
SUPABASE_PROJECT_REF=
SUPABASE_STORAGE_BUCKET=event-flyers
# The "Region" shown on that same S3 Configuration page (e.g. eu-west-1)
SUPABASE_STORAGE_REGION=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=

# --- Which websites may call the API --------------------------------------
# Local: the static site on port 5173. Production: https://shadrack213.github.io
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Production, once /admin/ is enabled: https://<your-api-domain>
CSRF_TRUSTED_ORIGINS=
